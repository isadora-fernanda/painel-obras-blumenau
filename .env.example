# Copie este arquivo para .env e preencha com os seus dados
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_DATABASE=obrasblumenau

# Chave da Groq para o assistente usar IA (https://console.groq.com).
# Sem ela, o assistente responde só por palavras-chave.
GROQ_API_KEY=

# Opcional: lê as obras de um CSV gerado com "processar_obras.py --csv" em vez do MySQL
# OBRAS_CSV=exemplo/obras.csv
